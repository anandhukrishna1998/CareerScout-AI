NODE_ENV=development
APP_ENV=development
ENABLE_DEMO_MODE=true

# Web (use /api when serving through Nginx, or http://localhost:8000 when running web+api directly)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# API
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://localhost
JWT_SECRET=change-me-super-long-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
UPLOAD_DIR=./storage/cvs
UPLOAD_MAX_MB=10
CV_ENCRYPTION_KEY=

# AI / LLM
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-embedding-004
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
AI_ENGINE_URL=http://ai-engine:8010

# Database / Cache (Docker default uses postgres; for standalone local API without Docker use: sqlite:///./careerscout.db)
POSTGRES_USER=careerscout
POSTGRES_PASSWORD=careerscout
POSTGRES_DB=careerscout
DATABASE_URL=postgresql+asyncpg://careerscout:careerscout@postgres:5432/careerscout
REDIS_URL=redis://redis:6379/0

# Email
EMAIL_PROVIDER=resend
RESEND_API_KEY=replace-me
SENDGRID_API_KEY=replace-me
EMAIL_FROM=no-reply@careerscout.ai

# Billing (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Worker / Scheduler (Europe-only & France-first sourcing)
EUROPE_ONLY_JOBS=true
SCRAPE_REGIONS=fr,eu
SCRAPE_JOB_FAMILIES=ai,data,ml,software
SCRAPE_CONCURRENCY=5
SCRAPE_HOURS_OLD=168
SCRAPE_SEARCH_TERM=AI OR Data OR Machine Learning OR Software
SCRAPE_LOCATION=France
SCRAPE_SOURCES=jobicy,ashby,greenhouse,lever,arbeitnow,france_travail,apec,indeed,linkedin_jobs,google_jobs
SCRAPE_BACKENDS_LINKEDIN_JOBS=jobspy,scrapy,playwright
SCRAPE_BACKENDS_GOOGLE_JOBS=httpx,jobspy,scrapy,playwright
SCRAPE_BACKENDS_WELCOME_TO_THE_JUNGLE=httpx,scrapy,playwright
SCRAPE_BACKENDS_HELLOWORK=httpx,scrapy,playwright
SCRAPE_BACKENDS_INDEED=jobspy,scrapy,playwright
SCRAPE_BACKENDS_APEC=httpx,scrapy,playwright
SCRAPE_BACKENDS_FRANCE_TRAVAIL=httpx,scrapy,playwright
SCRAPE_BACKENDS_MONSTER=jobspy,scrapy,playwright
SCRAPE_BACKENDS_FREE_WORK=httpx,scrapy,playwright
SCRAPE_BACKENDS_MALT=httpx,scrapy,playwright
SCRAPE_BACKENDS_REMOTEOK=httpx,scrapy,playwright
SCRAPE_BACKENDS_WEWORKREMOTELY=httpx,scrapy,playwright
SCRAPE_BACKENDS_GREENHOUSE=httpx,scrapy,playwright
SCRAPE_BACKENDS_LEVER=httpx,scrapy,playwright
SCRAPE_BACKENDS_ASHBY=httpx,scrapy,playwright
SCRAPE_BACKENDS_JOBICY=httpx,scrapy,playwright
SCRAPE_BACKENDS_COMPANY_CAREER_PAGES=httpx,scrapy,playwright

# French & European ATS company boards + optional provider credentials
SERPAPI_KEY=
ASHBY_COMPANIES=alan,pennylane,dust,nabla,photoroom,deepl
GREENHOUSE_COMPANIES=algolia,mirakl,datacamp
LEVER_COMPANIES=swile
FRANCE_TRAVAIL_ACCESS_TOKEN=
FRANCE_TRAVAIL_API_URL=https://api.francetravail.io/partenaire/offresdemploi/v2/offres/search
APEC_API_URL=
APEC_API_KEY=
WELCOME_TO_THE_JUNGLE_FEEDS=
HELLOWORK_FEEDS=
FREE_WORK_FEEDS=
MALT_FEEDS=
COMPANY_CAREER_PAGE_URLS=
DAILY_DIGEST_CRON=0 7 * * *
